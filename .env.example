# Copy to .env and fill in real values. Never commit .env.

# Local Postgres (docker compose)
POSTGRES_DB=drivenest
POSTGRES_USER=drivenest
POSTGRES_PASSWORD=

# Backend (Spring Boot) - host port matches docker-compose.yml
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/drivenest
SPRING_DATASOURCE_USERNAME=drivenest
SPRING_DATASOURCE_PASSWORD=

# Supabase (backend: JWT validation)
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=

# Frontend (Vite) - only public values here, the anon key is safe to expose
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8080
