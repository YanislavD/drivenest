# Copy to .env and fill in real values. Never commit .env.

# Backend (Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/drivenest
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Supabase (backend: JWT validation)
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=

# Frontend (Vite) - only public values here, the anon key is safe to expose
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8080
